<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.saga</groupId>
    <artifactId>eventuate-saga-parent</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>saga-common-eventuate</module>
        <module>order-service-eventuate</module>
        <module>consumer-service-eventuate</module>
        <module>kitchen-service-eventuate</module>
        <module>accounting-service-eventuate</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.2.3</spring-boot.version>
        <eventuate.tram.version>0.36.0.RELEASE</eventuate.tram.version>
        <eventuate.tram.sagas.version>0.26.0.RELEASE</eventuate.tram.sagas.version>
    </properties>

    <repositories>
        <repository>
	        <id>eventuate-tram-snapshots</id>
	        <name>Eventuate Tram Snapshots</name>
	        <url>https://oss.jfrog.org/artifactory/oss-snapshot-local</url>
	    </repository>
        <repository>
	        <id>eventuate-tram-release</id>
	        <name>Eventuate Tram Release</name>
	        <url>https://repo.eventuate.io/artifactory/libs-release</url>
	    </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Eventuate Tram core: transactional messaging over AMQP -->
            <dependency>
                <groupId>io.eventuate.tram.core</groupId>
                <artifactId>eventuate-tram-jdbc-rabbitmq</artifactId>
                <version>${eventuate.tram.version}</version>
            </dependency>

            <!-- Eventuate Tram Sagas: orchestration DSL + saga instance persistence -->
            <dependency>
                <groupId>io.eventuate.tram.sagas</groupId>
                <artifactId>eventuate-tram-sagas-spring-orchestration-simple-dsl-starter</artifactId>
                <version>${eventuate.tram.sagas.version}</version>
            </dependency>

            <!-- Participant support: SagaCommandHandlersBuilder on participant services -->
            <dependency>
                <groupId>io.eventuate.tram.sagas</groupId>
                <artifactId>eventuate-tram-sagas-spring-participant-starter</artifactId>
                <version>${eventuate.tram.sagas.version}</version>
            </dependency>

            <dependency>
                <groupId>com.saga</groupId>
                <artifactId>saga-common-eventuate</artifactId>
                <version>1.2.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
	
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
